# TITLE: Plate data to tidy data
# AUTHOR: Charli Geer
# Created: Feb 11, 2026
# Purpose: Take raw data from 50N mismatch experiment and transfer into
# the empty columns of an existing tidy dataframe. Will keep the order
# the same so this needs to be checked after transfer.
# HOW TO USE: fill in name of tidy template and raw plate data excel files.
# NOTE: they must match the exact raw format from the plate reader!
library(readxl)
library(tidyverse)
# read in the plate data
plate_1 <- read_excel("2026_02_06_MG_LACV_no_NSs_50N_exp3_plate1.xlsx") %>%
rename(excel_row = 1) %>%
mutate(row = 1:n()) %>%
select(row, everything())
colnames(plate_1) <- c("row", "excel_row", as.character(1:(ncol(plate_1)-1)))
plate_2 <- read_excel("2026_02_06_MG_LACV_no_NSs_50N_exp3_plate2.xlsx") %>%
rename(excel_row = 1) %>%
mutate(row = 1:n()) %>%
select(row, everything())
colnames(plate_2) <- c("row", "excel_row", as.character(1:(ncol(plate_2)-1)))
plate_3 <- read_excel("2026_02_06_MG_LACV_no_NSs_50N_exp3_plate3.xlsx") %>%
rename(excel_row = 1) %>%
mutate(row = 1:n()) %>%
select(row, everything())
colnames(plate_3) <- c("row", "excel_row", as.character(1:(ncol(plate_3)-1)))
# read in the tidy data template
tidy_df <- read_excel("2026_02_06_LACV_no_NSs_50N_exp3_tidy.xlsx")
# create function to collect data from each plate
# stack data vertically
extract_fLuc <- function(df) {
main <- df %>%
filter(row %in% 2:6) %>% # select rows
select(all_of(as.character(2:11))) %>% # select columns, have to brute force to use
as.matrix() %>% t() %>% as.vector() #transpose
extra <- df %>%
filter(row == 7) %>%
select(all_of(as.character(2:5))) %>%
as.matrix() %>% t() %>% as.vector()
c(main, extra)
}
extract_nLuc <- function(df) {
main <- df %>%
filter(row %in% 12:16) %>%  # replace with actual nLuc rows
select(all_of(as.character(2:11))) %>%
as.matrix() %>% t() %>% as.vector()
extra <- df %>%
filter(row == 17) %>%   # replace with actual nLuc extra row
select(all_of(as.character(2:5))) %>%
as.matrix() %>% t() %>% as.vector()
c(main, extra)
}
# add plate1 data
tidy_df <- tidy_df %>%
mutate(
fLuc = replace(
fLuc,
Plate == 1,
extract_fLuc(plate_1)
),
nLuc = replace(
nLuc,
Plate == 1,
extract_nLuc(plate_1)
)
)
# add plate2 data
tidy_df <- tidy_df %>%
mutate(
fLuc = replace(
fLuc,
Plate == 2,
extract_fLuc(plate_2)
),
nLuc = replace(
nLuc,
Plate == 2,
extract_nLuc(plate_2)
)
)
# add plate3 data
tidy_df <- tidy_df %>%
mutate(
fLuc = replace(
fLuc,
Plate == 3,
extract_fLuc(plate_3)
),
nLuc = replace(
nLuc,
Plate == 3,
extract_nLuc(plate_3)
)
)
View(tidy_df)
install.packages("writexl")
# TITLE: Plate data to tidy data
# AUTHOR: Charli Geer
# Created: Feb 11, 2026
# Purpose: Take raw data from 50N mismatch experiment and transfer into
# the empty columns of an existing tidy dataframe. Will keep the order
# the same so this needs to be checked after transfer.
# HOW TO USE: fill in name of tidy template and raw plate data excel files.
# NOTE: they must match the exact raw format from the plate reader!
library(readxl)
library(tidyverse)
library(writexl)
# specify output excel file name here:
output_file <- "2026_02_06_LACV_no_NSs_50N_exp3_tidy.xlsx"
# read in the plate data
plate_1 <- read_excel("2026_02_06_MG_LACV_no_NSs_50N_exp3_plate1.xlsx") %>%
rename(excel_row = 1) %>%
mutate(row = 1:n()) %>%
select(row, everything())
colnames(plate_1) <- c("row", "excel_row", as.character(1:(ncol(plate_1)-1)))
plate_2 <- read_excel("2026_02_06_MG_LACV_no_NSs_50N_exp3_plate2.xlsx") %>%
rename(excel_row = 1) %>%
mutate(row = 1:n()) %>%
select(row, everything())
colnames(plate_2) <- c("row", "excel_row", as.character(1:(ncol(plate_2)-1)))
plate_3 <- read_excel("2026_02_06_MG_LACV_no_NSs_50N_exp3_plate3.xlsx") %>%
rename(excel_row = 1) %>%
mutate(row = 1:n()) %>%
select(row, everything())
colnames(plate_3) <- c("row", "excel_row", as.character(1:(ncol(plate_3)-1)))
# read in the tidy data template
tidy_df <- read_excel("2026_02_06_LACV_no_NSs_50N_exp3_tidy_template.xlsx")
# create function to collect data from each plate
# stack data vertically
extract_fLuc <- function(df) {
main <- df %>%
filter(row %in% 2:6) %>% # select rows
select(all_of(as.character(2:11))) %>% # select columns, have to brute force to use
as.matrix() %>% t() %>% as.vector() #transpose
extra <- df %>%
filter(row == 7) %>%
select(all_of(as.character(2:5))) %>%
as.matrix() %>% t() %>% as.vector()
c(main, extra)
}
extract_nLuc <- function(df) {
main <- df %>%
filter(row %in% 12:16) %>%  # replace with actual nLuc rows
select(all_of(as.character(2:11))) %>%
as.matrix() %>% t() %>% as.vector()
extra <- df %>%
filter(row == 17) %>%   # replace with actual nLuc extra row
select(all_of(as.character(2:5))) %>%
as.matrix() %>% t() %>% as.vector()
c(main, extra)
}
# add plate1 data
tidy_df <- tidy_df %>%
mutate(
fLuc = replace(
fLuc,
Plate == 1,
extract_fLuc(plate_1)
),
nLuc = replace(
nLuc,
Plate == 1,
extract_nLuc(plate_1)
)
)
# add plate2 data
tidy_df <- tidy_df %>%
mutate(
fLuc = replace(
fLuc,
Plate == 2,
extract_fLuc(plate_2)
),
nLuc = replace(
nLuc,
Plate == 2,
extract_nLuc(plate_2)
)
)
# add plate3 data
tidy_df <- tidy_df %>%
mutate(
fLuc = replace(
fLuc,
Plate == 3,
extract_fLuc(plate_3)
),
nLuc = replace(
nLuc,
Plate == 3,
extract_nLuc(plate_3)
)
)
write_xlsx(tidy_df, path = output_file)
library(readxl)
library(tidyverse)
library(writexl)
# specify output excel file name here:
output_file <- "2026_01_17_BUNV_no_NSs_50N_exp3_tidy.xlsx"
# read in the plate data
plate_1 <- read_excel("2026_01_17_MG_BUNV_no_NSs_50N_exp3_plate1.xlsx") %>%
rename(excel_row = 1) %>%
mutate(row = 1:n()) %>%
select(row, everything())
getwd()
library(tidyverse)
library(readxl)
library(patchwork)
df <- read_excel("2026_02_06_LACV_no_NSs_50N_exp3_tidy.xlsx")
# calculate nLuc / fLuc
df <- df %>% mutate(nLuc_rel_fLuc = nLuc / fLuc)
# calculate N-only nLuc
df$bg_nLuc          <- df %>% filter(N == "LACV N only") %>% summarize(bg_nLuc = mean(nLuc)) %>% pull(bg_nLuc)
df$bg_nLuc_rel_fLuc <- df %>% filter(N == "LACV N only") %>% summarize(bg_nLuc_rel_fLuc = mean(nLuc_rel_fLuc)) %>% pull(bg_nLuc_rel_fLuc)
# normalize to N-only
df <- df %>% mutate(nLuc_rel_bg = nLuc / bg_nLuc,
nLuc_rel_fLuc_rel_bg = nLuc_rel_fLuc / bg_nLuc_rel_fLuc)
# pairwise % identity between GPCs involved
dist_df <- read_excel("../Orthobunya_metadata.xlsx")
df <- left_join(df, dist_df, by=c("N_pMDS" = "no_NSs_pMDS"))
# calculate averages of normalized luminescence
# use double-normalized luminescence values.
# That is, normalized to both N-only and fLuc
df_norm_avg <- df %>%
group_by (N) %>%
summarize(mean_lum     = mean(nLuc_rel_bg),
sd_lum       = sd(nLuc_rel_bg),
mean_rel_lum = mean(nLuc_rel_fLuc_rel_bg),
sd_rel_lum   = sd(nLuc_rel_fLuc_rel_bg),
LACV_pct_id  = mean(Pct_ID_LACV_N),
.groups="drop")
# save dataframe with mean luminescence and mean relative luminescence
write.csv(df_norm_avg, "LACV_no_NSs_50N_exp2_normalized_relative_luminescence.csv", row.names = FALSE)
# Set y axis min and max values for cases when std_dev > mean,
# This way, negative values won't be undefined by the log scale in ggplot
yaxis_min <- 1e-1
yaxis_max <- 1e5
# singly normalized luminescence - to N-only
ggplot(df_norm_avg) +
geom_point(aes(x=LACV_pct_id, y=mean_lum), shape=21,
fill="slateblue", color="black", size=3, stroke=0.25) +
geom_errorbar(aes(x=LACV_pct_id,
ymin = ifelse((mean_lum - sd_lum) < yaxis_min, yaxis_min, mean_lum - sd_lum),
ymax = ifelse((mean_lum + sd_lum) > yaxis_max, yaxis_max, mean_lum + sd_lum)),
linewidth=0.25, alpha=0.5, color="slateblue") +
geom_text(aes(x=LACV_pct_id, y=mean_lum, label=N),
size=2.5, color="grey60",
nudge_x=3,
nudge_y=0,
check_overlap = F ) +
xlab("Pairwise AA identity of N protein to LACV N protein (%)") +
ylab("nLuc relative N-only cells") +
scale_y_log10() +
theme_bw()  +
ggtitle("Activity of 50 N proteins with LACV L (no NSs)", subtitle="February 3, 2026")
# save as PDF
ggsave("2026_02_03_LACV_no_NSs_50N_results_singly_normalized.pdf", units="in", width=10, height=7.5)
# doubly normalized luminescence (normalize to N-only and fLuc)
ggplot(df_norm_avg) +
geom_point(aes(x=LACV_pct_id, y=mean_rel_lum), shape=21,
fill="slateblue", color="black", size=3, stroke=0.25) +
geom_errorbar(aes(x=LACV_pct_id,
ymin = ifelse((mean_rel_lum - sd_rel_lum) < yaxis_min, yaxis_min, mean_rel_lum - sd_rel_lum),
ymax = ifelse((mean_rel_lum + sd_rel_lum) > yaxis_max, yaxis_max, mean_rel_lum + sd_rel_lum)),
linewidth=0.25, alpha=0.5, color="slateblue") +
geom_text(aes(x=LACV_pct_id, y=mean_rel_lum, label=N),
size=2.5, color="grey60",
nudge_x=3,
nudge_y=0,
check_overlap = F ) +
xlab("Pairwise AA identity of N protein to LACV N protein (%)") +
ylab("nLuc relative to fLuc relative to N-only cells") +
scale_y_log10() +
theme_bw()  +
ggtitle("Activity of 50 N proteins with LACV L (no NSs)", subtitle="February 3, 2025")
# save as PDF
ggsave("2026_02_03_LACV_no_NSs_50N_results_doubly_normalized.pdf", units="in", width=10, height=7.5)

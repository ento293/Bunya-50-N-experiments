# doubly normalized luminescence (normalize to N-only and fLuc) and clean for presentations
ggplot(df) +
geom_point(aes(x= .data[[paste0(MG, "_pct_id")]], y=mean_rel_lum), shape=21,
fill= point_color,
color="black",
size=4,
stroke=0.25) +
geom_errorbar(aes(x=.data[[paste0(MG, "_pct_id")]],
ymin = ifelse((mean_rel_lum - sd_rel_lum) < yaxis_min, yaxis_min, mean_rel_lum - sd_rel_lum),
ymax = ifelse((mean_rel_lum + sd_rel_lum) > yaxis_max, yaxis_max, mean_rel_lum + sd_rel_lum)),
width=0.25,
linewidth = 0.25,
alpha=0.5,
color = error_bar_color) +
geom_text(aes(x=.data[[paste0(MG, "_pct_id")]], y=mean_rel_lum, label=N),
size=3.5,
color=name_color,
nudge_x=3,
nudge_y=0,
check_overlap = F ) +
xlab(glue("Pairwise AA identity of N protein to {MG} N protein (%)")) +
ylab("nLuc relative to fLuc relative to N-only cells") +
ggtitle(glue("Activity of 50 N proteins with {MG} L ({NSs_presence} NSs)"), subtitle= experiment_date) +
scale_y_log10() +
theme_bw()  +
theme(
axis.title = element_text(size = 16, color = "black"),
axis.text = element_text(size = 14, color = "black"),
panel.grid.minor = element_blank()
)
# TITLE: Make Plots
# AUTHOR: Charli Geer
# Created: Feb 26, 2026
# Purpose: Create single- and double-normalized graph of 50N experiment data
make_plots <- function(
df,                  # df_norm_avg from analysis
experiment_name,     # for file outputs
experiment_date,
MG,                  # LACV, BUNV, or KRIV
NSs_presence,        # with/yes or without/no
point_color = "slateblue",
error_bar_color = "slateblue",
name_color = "grey60"
) {
# Set y axis min and max values for cases when std_dev > mean,
# This way, negative values won't be undefined by the log scale in ggplot
yaxis_min <- 1e-1
yaxis_max <- 1e5
# singly normalized luminescence (normalize to N-only)
ggplot(df) +
geom_point(aes(x = .data[[paste0(MG, "_pct_id")]], y = mean_lum),
shape=21,
fill=point_color,
color="black",
size=3,
stroke=0.25) +
geom_errorbar(aes(x=.data[[paste0(MG, "_pct_id")]],
ymin = ifelse((mean_lum - sd_lum) < yaxis_min, yaxis_min, mean_lum - sd_lum),
ymax = ifelse((mean_lum + sd_lum) > yaxis_max, yaxis_max, mean_lum + sd_lum)),
width = 0.25,
linewidth=0.25,
alpha=0.5,
color = error_bar_color) +
geom_text(aes(x=.data[[paste0(MG, "_pct_id")]], y=mean_lum, label=N),
size=2.5,
color=name_color,
nudge_x=3,
nudge_y=0,
check_overlap = F ) +
xlab(glue("Pairwise AA identity of N protein to {MG} N protein (%)")) +
ylab("nLuc relative N-only cells") +
scale_y_log10() +
theme_bw()  +
ggtitle(glue("Activity of 50 N proteins with {MG} L ({NSs_presence} NSs)"), subtitle= experiment_date)
# save as PDF
ggsave(filename = glue("{experiment_name}_singly_normalized.pdf"),
path = "../plots",
units="in",
width=10,
height=7.5)
# doubly normalized luminescence (normalize to N-only and fLuc)
ggplot(df) +
geom_point(aes(x= .data[[paste0(MG, "_pct_id")]], y=mean_rel_lum), shape=21,
fill= point_color,
color="black",
size=3,
stroke=0.25) +
geom_errorbar(aes(x=.data[[paste0(MG, "_pct_id")]],
ymin = ifelse((mean_rel_lum - sd_rel_lum) < yaxis_min, yaxis_min, mean_rel_lum - sd_rel_lum),
ymax = ifelse((mean_rel_lum + sd_rel_lum) > yaxis_max, yaxis_max, mean_rel_lum + sd_rel_lum)),
width=0.25,
linewidth = 0.25,
alpha=0.5,
color = error_bar_color) +
geom_text(aes(x=.data[[paste0(MG, "_pct_id")]], y=mean_rel_lum, label=N),
size=2.5,
color=name_color,
nudge_x=3,
nudge_y=0,
check_overlap = F ) +
xlab(glue("Pairwise AA identity of N protein to {MG} N protein (%)")) +
ylab("nLuc relative to fLuc relative to N-only cells") +
scale_y_log10() +
theme_bw()  +
ggtitle(glue("Activity of 50 N proteins with {MG} L ({NSs_presence} NSs)"), subtitle= experiment_date)
# save as PDF
ggsave(filename = glue("{experiment_name}_doubly_normalized.pdf"),
path = "../plots",
units="in",
width=10,
height=7.5)
# doubly normalized luminescence (normalize to N-only and fLuc) and clean for presentations
ggplot(df) +
geom_point(aes(x= .data[[paste0(MG, "_pct_id")]], y=mean_rel_lum), shape=21,
fill= point_color,
color="black",
size=4,
stroke=0.25) +
geom_errorbar(aes(x=.data[[paste0(MG, "_pct_id")]],
ymin = ifelse((mean_rel_lum - sd_rel_lum) < yaxis_min, yaxis_min, mean_rel_lum - sd_rel_lum),
ymax = ifelse((mean_rel_lum + sd_rel_lum) > yaxis_max, yaxis_max, mean_rel_lum + sd_rel_lum)),
width=0.25,
linewidth = 0.25,
alpha=0.5,
color = error_bar_color) +
geom_text(aes(x=.data[[paste0(MG, "_pct_id")]], y=mean_rel_lum, label=N),
size=3.5,
color=name_color,
nudge_x=3,
nudge_y=0,
check_overlap = F ) +
xlab(glue("Pairwise AA identity of N protein to {MG} N protein (%)")) +
ylab("nLuc relative to fLuc relative to N-only cells") +
ggtitle(glue("Activity of 50 N proteins with {MG} L ({NSs_presence} NSs)"), subtitle= experiment_date) +
scale_y_log10() +
theme_bw()  +
theme(
axis.title = element_text(size = 16, color = "black"),
axis.text = element_text(size = 14, color = "black"),
panel.grid.minor = element_blank()
)
# save as PDF
ggsave(filename = glue("{experiment_name}_doubly_normalized_2.pdf"),
path = "../plots",
units="in",
width=10,
height=7.5)
}
setwd("/Users/charligeer/Documents/Lab_Projects/Repos/Bunya-50-N-experiments/2026_02_12_LACV_50N_no_NSs_exp3/data")
library(tidyverse)
library(readxl)
library(writexl)
library(glue)
source("../../shared/plate_to_tidy_data.R")
source("../../shared/make_plots.R")
# Make tidy data ------------------------------------------------------
plate_to_tidy(plate1 = "2026_02_15_MG_LACV_50N_no_NSs_exp3_plate1_corrected_layout.xlsx",
plate2 = "2026_02_15_MG_LACV_50N_no_NSs_exp3_plate2_corrected_layout.xlsx",
plate3 = "2026_02_15_MG_LACV_50N_no_NSs_exp3_plate3_corrected_layout.xlsx",
template = "2026_02_15_LACV_50N_no_NSs_exp3_tidy_template.xlsx",
output_file = "2026_02_15_LACV_50N_no_NSs_exp3_tidy.xlsx")
# Analysis ------------------------------------------------------------
# define experiment name for saving data and plots
experiment <- "LACV_50N_no_NSs_exp3"
# read in tidy data
df <- read_excel("2026_02_15_LACV_50N_no_NSs_exp3_tidy.xlsx")
#### normalization ####
# calculate nLuc / fLuc
df <- df %>% mutate(nLuc_rel_fLuc = nLuc / fLuc)
# calculate N-only nLuc average
df$bg_nLuc          <- df %>% filter(N == "LACV N only") %>% summarize(bg_nLuc = mean(nLuc)) %>% pull(bg_nLuc)
df$bg_nLuc_rel_fLuc <- df %>% filter(N == "LACV N only") %>% summarize(bg_nLuc_rel_fLuc = mean(nLuc_rel_fLuc)) %>% pull(bg_nLuc_rel_fLuc)
# normalize to N-only nLuc average
df <- df %>% mutate(nLuc_rel_bg = nLuc / bg_nLuc,
nLuc_rel_fLuc_rel_bg = nLuc_rel_fLuc / bg_nLuc_rel_fLuc)
#### activity vs. distance ####
# get pairwise % identity between N proteins involved
dist_df <- read_excel("../../shared/N_protein_metadata.xlsx")
df <- left_join(df, dist_df, by=c("N_pMDS" = "pMDS"))
# calculate averages of normalized luminescence
# single normalized = lum (normalized to N-only)
# double normalized = rel_lum (normalized to fLuc and N-only)
df_norm_avg <- df %>%
group_by (N) %>%
summarize(mean_lum     = mean(nLuc_rel_bg),
sd_lum       = sd(nLuc_rel_bg),
mean_rel_lum = mean(nLuc_rel_fLuc_rel_bg),
sd_rel_lum   = sd(nLuc_rel_fLuc_rel_bg),
LACV_pct_id  = mean(Pct_ID_LACV_N),
pMDS         = mean(N_pMDS),
.groups="drop")
# save dataframe with mean luminescence and mean relative luminescence
write_xlsx(df_norm_avg, glue("{experiment}_normalized_data.xlsx"))
# Make plots ----------------------------------------------------------
make_plots(df = df_norm_avg,
experiment_name = "2026_02_15_LACV_50N_no_NSs_exp3",
experiment_date = "Feburary 15, 2026",
MG = "LACV",
NSs_presence = "no"
)

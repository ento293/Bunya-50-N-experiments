# setup
weight <- read.csv("ex9-13.txt", quote = "'")
library(tidyverse)
WtLoss <- weight %>%
pivot_longer(A1:S, names_to = "Trt", values_to = "Loss") %>%
mutate(Trt = as_factor(Trt)) %>%
mutate(Trt = fct_relevel(Trt, "S"))
str(WtLoss)
table(WtLoss$Trt)
# Q1
OneWayFit <- lm(Loss ~ Trt, data = WtLoss)
anova(OneWayFit)
#Q2
library(emmeans)
emmout <- emmeans(OneWayFit, ~ Trt)
pairs(emmout, adjust = "none")
#Q3
pairs(emmout)

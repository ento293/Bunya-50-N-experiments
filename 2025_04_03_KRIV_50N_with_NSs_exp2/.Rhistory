# save the plot with the sd error bars and individual points
ggsave(filename = "2025.01.13_double_normalized.png",
plot = Graph_sd_individ_points,
width = 6,
height = 5,
dpi = 300)
# Normalize the data
# Divided the nano Luc reading by the firefly Luc reading for each well (each replicate)
NormLuc <- rawLuc
NormLuc$rep1 <- rawLuc$nLuc1/rawLuc$fLuc1
NormLuc$rep2 <- rawLuc$nLuc2/rawLuc$fLuc2
NormLuc$rep3 <- rawLuc$nLuc3/rawLuc$fLuc3
# Average each replicate
NormLuc$avg_replicates <- rowMeans(NormLuc[, c("rep1", "rep2", "rep3")])
# change MG column to 'factor' to keep order the same in the bar plot
Sorted_Luc <- NormLuc %>%
mutate(MG = factor(MG, levels= MG))
# pivot the sorted df to put reps in new column
longer_luc <- Sorted_Luc %>%
pivot_longer(
cols = c(rep1, rep2, rep3),
names_to = "replicate",
values_to = "individ_point"
)
# Calculate the standard deviation for each group and add to sorted_luc df
# Need to do this to add error bars to the chart
# First used summarize to get the standard deviation, then added sd to the sorted df
sd_column <- longer_luc %>%
group_by(MG) %>%
summarize(
sd_value = sd(individ_point)
)
Sorted_Luc <- Sorted_Luc %>%
left_join(sd_column, by = "MG")
# create bar plot with individual points and error bars included
Graph_sd_individ_points <- ggplot(Sorted_Luc, aes(x = MG, y = avg_replicates) ) +
geom_bar(stat = "identity", fill = "skyblue") +
geom_errorbar(
aes(ymin = avg_replicates - sd_value, ymax = avg_replicates + sd_value),
width = 0.2,
color = "darkgray") +
geom_point(data= longer_luc, mapping = aes(x = MG, y = individ_point),
inherit.aes = FALSE) +
scale_y_continuous(trans='log10') +
labs( x = "Minigenome",
y = "nLuc/fLuc",
title = "Maxi prep validation, fLuc normalization",
subtitle = "January 11, 2025")   +
theme(axis.text.x = element_text(color = "black", angle = 45, hjust = 1),
axis.text.y = element_text(color = "black", size = 10),  # Setting y-axis text color to black
panel.grid.major = element_blank(),  # Removing major grid lines
panel.grid.minor = element_blank(),  # Removing minor grid lines
panel.background = element_blank(),  # Removing background grid
axis.line = element_line(color = "black", size = 0.5))
Graph_sd_individ_points
# save the plot with the sd error bars and individual points
ggsave(filename = "2025.01.13_fLuc_normalized.png",
plot = Graph_sd_individ_points,
width = 6,
height = 5,
dpi = 300)
